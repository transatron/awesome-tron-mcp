# Network URLs
FULL_NODE_URL=https://api.trongrid.io
TRONGRID_API_URL=https://api.trongrid.io
SOLIDITY_NODE_URL=https://api.trongrid.io
EVENT_SERVER_URL=https://api.trongrid.io

# API Keys
TRONGRID_API_KEY=
TRONSCAN_API_KEY=
API_KEYS=                          # Legacy comma-separated keys

# Configuration
PRIMARY_API=TRONGRID               # TRONGRID or TRONSCAN
TRONGRID_API_RATE_LIMIT=3          # Hits per second
TRONSCAN_API_RATE_LIMIT=3          # Hits per second
NETWORK=mainnet                    # mainnet, shasta, nile
PRIVATE_KEY=                       # For transactions
ENABLE_CACHE=true
CACHE_TTL=300
DEBUG=false
