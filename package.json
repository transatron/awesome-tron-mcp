{
  "name": "mcp-tron-server",
  "version": "1.0.0",
  "description": "MCP Server for TRON blockchain interaction (TypeScript)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test --test-concurrency=1 'test/**/*.test.ts'"
  },
  "keywords": [
    "mcp",
    "tron",
    "blockchain",
    "tronweb",
    "typescript"
  ],
  "author": "Netts.io",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.2",
    "cheerio": "^1.1.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2",
    "tronweb": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
